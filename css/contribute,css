        @media (max-width: 768px) {
            .file-preview.has-files {
                max-height: 180px;
            }
            
            .file-item {
                flex-wrap: wrap;
            }
            
            .file-name {
                width: 100%;
                margin-bottom: 5px;
            }
            
            .file-size, .file-remove {
                margin: 0 5px 0 0;
            }
        }

        @media (max-width: 480px) {
            .file-preview.has-files {
                max-height: 150px;
                padding: 8px;
            }
            
            .file-item {
                padding: 0.6rem 0.8rem;
            }
        }